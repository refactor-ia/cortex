{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/refactor-ia/cortex/schemas/capability.schema.json",
  "title": "Cortex capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "family", "source", "activation", "provenance", "license", "redistributionAllowed"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "id": {
      "type": "string",
      "maxLength": 57,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[^\\r\\n\\u2028\\u2029]*[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"
    },
    "family": {
      "type": "string",
      "enum": [
        "reasoning", "model-intelligence", "execution", "quality-assurance", "web",
        "mobile", "pcsoft", "services", "personal", "memory-integration", "documentation"
      ]
    },
    "source": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))[^/\\\\]+(?:/[^/\\\\]+)*\\.md(?![\\s\\S])"},
    "activation": {"type": "string", "enum": ["automatic", "dormant"]},
    "provenance": {"type": "string", "enum": ["cortex-owned", "third-party"]},
    "license": {"type": "string", "pattern": "^[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[^\\r\\n\\u2028\\u2029]*[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"},
    "redistributionAllowed": {"type": "boolean", "const": true},
    "provenanceUrl": {"type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?(?:[/?#](?:[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF%]|%[0-9A-Fa-f]{2})*)?(?![\\s\\S])"},
    "redistributionUrl": {"type": "string", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?(?:[/?#](?:[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF%]|%[0-9A-Fa-f]{2})*)?(?![\\s\\S])"}
  },
  "allOf": [
    {
      "if": {"properties": {"provenance": {"const": "cortex-owned"}}, "required": ["provenance"]},
      "then": {
        "properties": {"license": {"const": "CC-BY-SA-4.0"}},
        "not": {"anyOf": [{"required": ["provenanceUrl"]}, {"required": ["redistributionUrl"]}]}
      }
    },
    {
      "if": {"properties": {"provenance": {"const": "third-party"}}, "required": ["provenance"]},
      "then": {"required": ["provenanceUrl", "redistributionUrl"]}
    }
  ]
}
